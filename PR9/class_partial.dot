digraph C {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
  node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
  edge [fontname="Times New Roman", fontsize=9, color="#555555"];
  w [label="{Warehouse|- items Map[String,StockItem]\l- movements List[StockMovement]\l|+ addItem(StockItem)\l+ receive(String,int)\l+ issue(String,int)\l+ findByCategory(Category) List\l+ totalsByCategory() Map\l+ getItem(String) StockItem\l+ getMovements() List\l}", fillcolor="#F7FBFF", color="#2F5597"];
  i [label="{StockItem|- code String\l- name String\l- category Category\l- quantity int\l|+ StockItem(String,String,Category,int)\l+ increase(int)\l+ decrease(int)\l+ getCode() String\l+ getName() String\l+ getCategory() Category\l+ getQuantity() int\l+ equals(Object) boolean\l+ hashCode() int\l}", fillcolor="#F7FBFF", color="#2F5597"];
  m [label="{StockMovement|- itemCode String\l- type MovementType\l- quantity int\l|+ StockMovement(...)\l}", fillcolor="#F7FBFF", color="#2F5597"];
  c [label="{\<\<enumeration\>\>\nCategory|COMPUTER\lDISPLAY\lPERIPHERAL\lNETWORK\l}", fillcolor="#F7FBFF", color="#2F5597"];
  mt [label="{\<\<enumeration\>\>\nMovementType|RECEIVE\lISSUE\l}", fillcolor="#F7FBFF", color="#2F5597"];
  w -> i [label="0..*", arrowtail=diamond, dir=both];
  w -> m [label="0..*", arrowtail=diamond, dir=both];
  i -> c [style=dashed, label="uses"];
  m -> mt [style=dashed, label="uses"];
}