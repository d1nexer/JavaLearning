digraph C {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
  node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
  edge [fontname="Times New Roman", fontsize=9, color="#555555"];
  a [label="{SalesAnalyticsService|- SECONDARY_SORT_LIMIT : int = 15\l|+ topSales(List[Sale], double, int) List[Sale]\l+ maxSale(List[Sale]) Optional[Sale]\l+ totalsByManager(List[Sale]) Map[String, Double]\l+ averageByRegion(List[Sale], String) double\l- secondarySortComparator() Comparator[Sale]\l}", fillcolor="#F7FBFF", color="#2F5597"];
  s [label="{\<\<record\>\>\nSale|- id : String\l- manager : String\l- region : String\l- amount : double\l|}", fillcolor="#F7FBFF", color="#2F5597"];
  a -> s [label="processes 0..*", style=dashed, arrowhead=open];
}