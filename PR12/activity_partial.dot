digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
  node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
  edge [fontname="Times New Roman", fontsize=9, color="#555555"];
  start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
  end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
  n1 [label="Получить коллекцию продаж\n(проверка на null / пустоту)"];
  n2 [label="Сформировать stream\n(sales.stream())"];
  n3 [label="Отфильтровать элементы по условию\n(filter: сумма >= min или регион)"];
  n4 [label="Отсортировать через Comparator\nи ограничить выборку (sorted / limit)"];
  n5 [label="Выполнить терминальную операцию\n(toList, max, groupingBy, average)"];
  n6 [label="Результат найден", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
  n7 [label="Вернуть итоговый результат"];
  n8 [label="Вернуть Optional.empty, 0.0\nили пустую коллекцию/карту"];
  start -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5;
  n5 -> n6;
  n6 -> n7 [label="да"];
  n6 -> n8 [label="нет"];
  n7 -> end;
  n8 -> end;
}