digraph C {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
  node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
  edge [fontname="Times New Roman", fontsize=9, color="#555555"];
  p [label="{ClientCsvParser|- DELIMITER : String = \";\"\l- EXPECTED_COLUMNS : int = 3\l|+ parse(String, int) ClientDraft\l}", fillcolor="#F7FBFF", color="#2F5597"];
  v [label="{ClientValidator|- MAX_NAME_LENGTH : int = 15\l|+ validate(ClientDraft) List[String]\l- isValidEmail(String) boolean\l}", fillcolor="#F7FBFF", color="#2F5597"];
  i [label="{ClientImporter|- parser : ClientCsvParser\l- validator : ClientValidator\l- repository : ClientRepository\l|+ ClientImporter(ClientRepository)\l+ importFile(Path) ImportResult\l}", fillcolor="#F7FBFF", color="#2F5597"];
  r [label="{ClientRepository|- data : Map[String,Client]\l|+ save(Client) void\l+ findByInn(String) Client\l}", fillcolor="#F7FBFF", color="#2F5597"];
  res [label="{ImportResult|- accepted : int\l- errors : List[ImportError]\l|+ addAccepted() void\l+ addError(ImportError) void\l+ accepted() int\l+ errors() List[ImportError]\l}", fillcolor="#F7FBFF", color="#2F5597"];
  err [label="{\<\<record\>\>\nImportError|- lineNumber : int\l- message : String\l|}", fillcolor="#F7FBFF", color="#2F5597"];
  draft [label="{\<\<record\>\>\nClientDraft|- inn : String\l- name : String\l- email : String\l|}", fillcolor="#F7FBFF", color="#2F5597"];
  client [label="{\<\<record\>\>\nClient|- inn : String\l- name : String\l- email : String\l|}", fillcolor="#F7FBFF", color="#2F5597"];
  i -> p [label="1", arrowtail=odiamond, dir=both];
  i -> v [label="1", arrowtail=odiamond, dir=both];
  i -> r [label="1", arrowtail=odiamond, dir=both];
  i -> res [label="returns", style=dashed, arrowhead=open];
  res -> err [label="0..*", arrowtail=diamond, dir=both];
  p -> draft [label="creates", style=dashed, arrowhead=open];
  v -> draft [label="uses", style=dashed, arrowhead=open];
  r -> client [label="stores", style=dashed, arrowhead=open];
}