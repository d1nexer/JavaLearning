digraph C {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
  node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
  edge [fontname="Times New Roman", fontsize=9, color="#555555"];
  p [label="{\<\<interface\>\>\nDeliveryPolicy||+ supports(DeliveryRequest) boolean\l+ calculateCost(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
  std [label="{StandardCourierPolicy|- MIN_COST : double = 15.0\l|+ supports(DeliveryRequest) boolean\l+ calculateCost(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
  exp [label="{ExpressPolicy||+ supports(DeliveryRequest) boolean\l+ calculateCost(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
  pick [label="{PickupPolicy||+ supports(DeliveryRequest) boolean\l+ calculateCost(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
  post [label="{PostalDeliveryPolicy||+ supports(DeliveryRequest) boolean\l+ calculateCost(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
  f [label="{DeliveryPolicyFactory|- policies : Map[DeliveryType,DeliveryPolicy]\l|+ DeliveryPolicyFactory()\l+ get(DeliveryType) DeliveryPolicy\l}", fillcolor="#F7FBFF", color="#2F5597"];
  s [label="{DeliveryService|- factory : DeliveryPolicyFactory\l|+ DeliveryService(DeliveryPolicyFactory)\l+ calculate(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
  req [label="{\<\<record\>\>\nDeliveryRequest|- type : DeliveryType\l- distanceKm : double\l- weightKg : double\l- orderAmount : double\l|}", fillcolor="#F7FBFF", color="#2F5597"];
  dt [label="{\<\<enumeration\>\>\nDeliveryType|STANDARD\lEXPRESS\lPICKUP\lPOSTAL\l}", fillcolor="#F7FBFF", color="#2F5597"];
  std -> p [label="implements", arrowhead=empty, style=dashed];
  exp -> p [label="implements", arrowhead=empty, style=dashed];
  pick -> p [label="implements", arrowhead=empty, style=dashed];
  post -> p [label="implements", arrowhead=empty, style=dashed];
  f -> p [label="creates", style=dashed, arrowhead=open];
  s -> f [label="1", arrowtail=odiamond, dir=both];
  s -> req [style=dashed, label="uses"];
  req -> dt [style=dashed, label="uses"];
}